# Supabase Postgres — copy from Project Settings → Database → Connection string (URI).
# Local Docker Postgres example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/solvia?sslmode=disable
#
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# API
CORS_ORIGINS=https://solvia.app,http://localhost:8000

# Firecrawl (scrape)
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Gemini
GOOGLE_API_KEY=AIzaSy...your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Google Custom Search (SERP)
GOOGLE_CSE_API_KEY=AIzaSy...your-cse-key
GOOGLE_CSE_ID=your-search-engine-cx

# Optional timeouts (seconds)
# SCRAPE_TIMEOUT_SEC=120
# LLM_TIMEOUT_SEC=120
# SERP_TIMEOUT_SEC=60
# LLM_MAX_OUTPUT_TOKENS=8192