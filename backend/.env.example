# Supabase Postgres — copy from Project Settings → Database → Connection string (URI).
# Local Docker Postgres example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/solvia?sslmode=disable
#
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# API
CORS_ORIGINS=https://solvia.app,http://localhost:8000,http://localhost:4000,http://127.0.0.1:4000

# Firecrawl (scrape)
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Gemini
GOOGLE_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Serper.dev (SERP) — get key at https://serper.dev/api-key
SERPER_API_KEY=your-serper-api-key

# Email Settings (new)
SENDER_EMAIL=info@solvia.app
APP_PASSWORD=app-password
SMTP=smtp.zoho.com

# Zoho SMTP — required
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=info@solvia.ap
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=info@solvia.app
SMTP_FROM_NAME=Solvia Labs
SMTP_USE_TLS=true

# Optional but recommended
SMTP_REPLY_TO=nadra@solvia.app

# Admin dashboard (keep secret — never commit the real value)
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-use-openssl-rand-hex-32
